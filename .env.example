# TestLey — variables de entorno y secretos. NUNCA subas valores reales al repositorio ni los pegues en un chat.
# Dónde van: GitHub → Settings → Secrets and variables → Actions (workers) · Supabase → Edge Functions → Secrets (funciones).
# Sin un secreto, la función correspondiente queda desactivada o en estado «sin_proveedor»: nada se simula.

# --- Base de datos (Supabase) ---
# SUPABASE_URL y la clave publicable ya están en config.json (son públicas por diseño).
SUPABASE_SERVICE_ROLE_KEY=            # GitHub Actions (Growth OS: retención, seguidores de Telegram, informe con métricas). Nunca en el navegador.

# --- IA (LLM) ---
ANTHROPIC_API_KEY=                    # Actions (extracción de documentos ambiguos; redacción si flags.ai_growth) y Supabase (tutor)
LLM_API_KEY=                          # alternativa a ANTHROPIC_API_KEY para el Growth OS
LLM_MODEL_FAST=claude-haiku-4-5-20251001
LLM_MODEL_BALANCED=claude-sonnet-5-5
LLM_MODEL_ADVANCED=claude-opus-5-5
INGESTA_MODEL=claude-haiku-4-5-20251001
TUTOR_MODEL=claude-haiku-4-5-20251001  # Supabase
TUTOR_LIMITE_DIARIO=40                 # Supabase

# --- Pagos (Lemon Squeezy) ---
LEMONSQUEEZY_WEBHOOK_SECRET=          # Supabase (función lemon-webhook): el «Signing secret» del webhook
LS_STORE_ID=485627                    # Supabase: rechaza notificaciones de otras tiendas
# LEMON_SQUEEZY_API_KEY no hace falta: el webhook firmado basta para el entitlement.

# --- Email (servicio notificar) ---
NOTIF_CRON_SECRET=                    # Supabase y Actions: autoriza las llamadas a la función notificar
NOTIF_URL=                            # Actions: URL de la función notificar desplegada
EMAIL_PROVIDER=none                   # Supabase: none | resend | brevo | postmark
EMAIL_FROM=                           # Supabase: remitente verificado en el proveedor
RESEND_API_KEY=
BREVO_API_KEY=
POSTMARK_TOKEN=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=                   # Actions (canal y avisos) y Supabase (función telegram, comandos del bot)
TELEGRAM_CHANNEL_ID=                  # Actions: @canal o id numérico del canal público de TestLey
TELEGRAM_WEBHOOK_SECRET=              # Supabase: el secret_token de setWebhook

# --- Vídeo (sin adaptador real todavía: solo mock) ---
VIDEO_PROVIDER=                       # mock (tests). Adaptadores reales pendientes de alta y verificación de API.
VIDEO_PROVIDER_KEY=

# --- Ads (sin API conectada: gasto por CSV en crecimiento/privado/ads_gasto.csv) ---
GOOGLE_ADS_DEVELOPER_TOKEN=
META_ADS_ACCESS_TOKEN=

# --- Web ---
SITE_URL=https://globalfons.github.io/empresa-ia/   # Supabase: URL pública de la web
